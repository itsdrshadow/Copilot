<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="driving_report.db" />
        <include domain="database" path="driving_report.db-wal" />
        <include domain="database" path="driving_report.db-shm" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
        <exclude domain="root" path="cache" />
        <exclude domain="root" path="code_cache" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="driving_report.db" />
        <include domain="database" path="driving_report.db-wal" />
        <include domain="database" path="driving_report.db-shm" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
        <exclude domain="root" path="cache" />
        <exclude domain="root" path="code_cache" />
    </device-transfer>
</data-extraction-rules>
